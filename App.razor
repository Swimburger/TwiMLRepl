@using System.Xml.Linq
@inject IJSRuntime JS
@implements IAsyncDisposable

<main class="repl" aria-labelledby="repl-heading">
    <section class="workspace-shell" aria-label="TwiML code workspace">
        <div class="control-bar">
            <div class="example-picker">
                <label for="example">Example</label>
                <select id="example" value="@selectedExample" @onchange="ChangeExample" disabled="@isRunning">
                    <option value="sms">SMS reply</option>
                    <option value="voice">Voice response</option>
                </select>
            </div>
            <div class="toolbar" role="toolbar" aria-label="Editor actions" focusgroup="toolbar wrap">
                <div class="toolbar-group" role="group" aria-label="Run controls">
                    <button type="button" class="primary" @onclick="Run" disabled="@isRunning">Run</button>
                    <button type="button" @onclick="Stop" disabled="@(!isRunning)">Stop</button>
                    <button type="button" @onclick="Reset" disabled="@isRunning">Reset</button>
                </div>
                <span class="toolbar-separator" role="separator" aria-orientation="vertical"></span>
                <div class="toolbar-group output-actions" role="group" aria-label="TwiML output actions">
                    <button type="button" aria-label="Format XML" @onclick="FormatXml" disabled="@(!xmlValid || isRunning)">Format</button>
                    <button type="button" aria-label="Copy TwiML" @onclick="CopyXml" disabled="@(!xmlValid)">Copy</button>
                    <button type="button" aria-label="Download TwiML" @onclick="DownloadXml" disabled="@(!xmlValid)">Download</button>
                </div>
            </div>
        </div>

        <div class="run-state" data-state="@status">
            @if (isRunning)
            {
                <progress aria-label="Compiler loading and execution in progress"></progress>
            }
            <p id="run-status" role="status" aria-live="polite">@statusMessage</p>
            @if (outputStale)
            {
                <span class="stale-badge">Output is stale</span>
            }
        </div>

        <div class="editor-grid">
            <section class="editor-panel" aria-labelledby="csharp-heading">
                <h2 id="csharp-heading">C# input</h2>
                <div id="csharp-editor" class="monaco-editor-container" @ref="csharpEditorElement"></div>
            </section>
            <section class="editor-panel" aria-labelledby="xml-heading">
                <h2 id="xml-heading">TwiML output</h2>
                <div id="xml-editor" class="monaco-editor-container" @ref="xmlEditorElement"></div>
            </section>
        </div>
    </section>
</main>

@code {
    private const int TimeoutMilliseconds = 10_000;
    private const string SmsCode = "var response = new MessagingResponse();\nresponse.Message(\"Hello from C#!\");\nreturn response;";
    private const string VoiceCode = "var response = new VoiceResponse();\nresponse.Say(\"Hello from C sharp!\");\nreturn response;";
    private ElementReference csharpEditorElement;
    private ElementReference xmlEditorElement;
    private IJSObjectReference? editorModule;
    private DotNetObjectReference<App>? selfReference;
    private string selectedExample = "sms";
    private string status = "ready";
    private string statusMessage = "Ready. Choose an example or edit the C# code, then select Run.";
    private bool isRunning;
    private bool xmlValid;
    private bool outputStale;
    private bool sourceChangedDuringRun;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                editorModule = await JS.InvokeAsync<IJSObjectReference>("import", "./assets/monaco/integration.js");
                selfReference = DotNetObjectReference.Create(this);
                await editorModule.InvokeVoidAsync("createEditors", csharpEditorElement, xmlEditorElement, SmsCode, selfReference);
                await JS.InvokeVoidAsync("twimlUi.initToolbar");
            }
            catch (JSException exception)
            {
                status = "runtime-error";
                statusMessage = $"The code editor could not be initialized: {exception.Message}";
                StateHasChanged();
            }
        }
    }

    [JSInvokable]
    public Task OnSourceChanged()
    {
        if (isRunning)
        {
            sourceChangedDuringRun = true;
            return Task.CompletedTask;
        }
        outputStale = xmlValid || !string.IsNullOrEmpty(statusMessage);
        xmlValid = false;
        status = "stale";
        statusMessage = "Source changed. The output is stale; select Run to refresh it.";
        return InvokeAsync(StateHasChanged);
    }

    private async Task Run()
    {
        if (editorModule is null || isRunning) return;
        isRunning = true;
        sourceChangedDuringRun = false;
        xmlValid = false;
        outputStale = false;
        status = "running";
        statusMessage = "Loading the isolated compiler and reference assemblies, then running your code…";
        if (!await TryInvokeEditorVoidAsync("setOutput", string.Empty)) return;
        StateHasChanged();

        var code = await TryGetEditorText("getSource");
        if (code is null) return;
        WorkerResult result;
        try
        {
            result = await JS.InvokeAsync<WorkerResult>("twimlCompiler.run", code, TimeoutMilliseconds);
        }
        catch (JSException exception)
        {
            result = new WorkerResult { Message = $"The compiler worker failed: {exception.Message}" };
        }
        isRunning = false;
        if (sourceChangedDuringRun)
        {
            await TryInvokeEditorVoidAsync("setOutput", string.Empty);
            outputStale = true;
            xmlValid = false;
            status = "stale";
            statusMessage = "Source changed while the code was running. The result was discarded; select Run again.";
            return;
        }
        status = result.Status;
        xmlValid = result.XmlValid;
        statusMessage = result.Message;
        await TryInvokeEditorVoidAsync("setOutput", result.Output ?? string.Empty);
    }

    private async Task Stop()
    {
        if (!isRunning) return;
        try { await JS.InvokeVoidAsync("twimlCompiler.stop"); }
        catch (JSException exception)
        {
            isRunning = false;
            status = "runtime-error";
            statusMessage = $"The compiler worker could not be stopped cleanly: {exception.Message}";
        }
    }

    private async Task ChangeExample(ChangeEventArgs args)
    {
        selectedExample = args.Value?.ToString() == "voice" ? "voice" : "sms";
        await SetSource(selectedExample == "voice" ? VoiceCode : SmsCode);
    }

    private async Task Reset()
    {
        await SetSource(selectedExample == "voice" ? VoiceCode : SmsCode);
        if (editorModule is not null) await TryInvokeEditorVoidAsync("setOutput", string.Empty);
        xmlValid = false;
        outputStale = false;
        status = "ready";
        statusMessage = "Reset complete. Select Run to generate TwiML.";
    }

    private async Task SetSource(string value)
    {
        if (editorModule is null) return;
        if (!await TryInvokeEditorVoidAsync("setSource", value, false)) return;
        outputStale = true;
        xmlValid = false;
        status = "stale";
        statusMessage = "Example loaded. Select Run to generate current output.";
    }

    private async Task FormatXml()
    {
        if (editorModule is null) return;
        try
        {
            var output = await editorModule.InvokeAsync<string>("getOutput");
            await editorModule.InvokeVoidAsync("setOutput", XDocument.Parse(output).ToString());
            status = "success";
            statusMessage = "TwiML formatted. XML is valid.";
        }
        catch (Exception exception)
        {
            xmlValid = false;
            status = "runtime-error";
            statusMessage = $"XML validation failed: {exception.Message}";
        }
    }

    private async Task CopyXml()
    {
        if (editorModule is null) return;
        bool copied;
        try { copied = await JS.InvokeAsync<bool>("twimlUi.copyText", await editorModule.InvokeAsync<string>("getOutput")); }
        catch (JSException) { copied = false; }
        status = copied ? "success" : "runtime-error";
        statusMessage = copied ? "TwiML copied to the clipboard." : "Copy failed. Clipboard permission may be blocked.";
    }

    private async Task DownloadXml()
    {
        if (editorModule is null) return;
        try
        {
            await JS.InvokeVoidAsync("twimlUi.downloadText", "twiml.xml", await editorModule.InvokeAsync<string>("getOutput"));
            status = "success";
            statusMessage = "TwiML downloaded as twiml.xml.";
        }
        catch (JSException exception)
        {
            status = "runtime-error";
            statusMessage = $"Download failed: {exception.Message}";
        }
    }

    private async ValueTask<bool> TryInvokeEditorVoidAsync(string identifier, params object?[] args)
    {
        if (editorModule is null) return false;
        try
        {
            await editorModule.InvokeVoidAsync(identifier, args);
            return true;
        }
        catch (JSException exception)
        {
            isRunning = false;
            status = "runtime-error";
            statusMessage = $"The code editor failed: {exception.Message}";
            return false;
        }
    }

    private async ValueTask<string?> TryGetEditorText(string identifier)
    {
        if (editorModule is null) return null;
        try
        {
            return await editorModule.InvokeAsync<string>(identifier);
        }
        catch (JSException exception)
        {
            isRunning = false;
            status = "runtime-error";
            statusMessage = $"The code editor failed: {exception.Message}";
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("twimlCompiler.dispose"); }
        catch (JSDisconnectedException) { }
        if (editorModule is not null)
        {
            try
            {
                await editorModule.InvokeVoidAsync("disposeEditors");
                await editorModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
        selfReference?.Dispose();
    }

    private sealed class WorkerResult
    {
        public string Status { get; set; } = "runtime-error";
        public string? Output { get; set; }
        public string Message { get; set; } = "The compiler did not return a result.";
        public bool XmlValid { get; set; }
    }
}
